# ================= 和风天气 (QWeather) =================
# 注册地址: https://dev.qweather.com/
# 免费订阅版即可满足实时天气 + 7天预报 + 生活指数的使用
QWEATHER_API_KEY=your_qweather_key

# ================= 百度智能云千帆 · 伏羲大模型（研判 / 问答） =================
# 用于气象灾害研判、病虫害风险分析与农事智能问答（原有功能）
# 接口: https://qianfan.baidubce.com/v2（OpenAI 兼容）
# API Key 申请: https://console.bce.baidu.com/qianfan/ais/console/onlineService
QIANFAN_API_KEY=your_qianfan_api_key

# 可选: 接口地址，默认千帆 v2（与文心模型配套）
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# 可选: 模型名称，默认 ernie-4.0-8k（文心 4.0）；使用伏羲气象大模型请改为对应 model
QIANFAN_MODEL=ernie-4.0-8k

# ================= 通义千问 · 智能执行 Agent 决策判断 =================
# 用于「智能执行 Agent」的决策判断（自动浇水 / 自动打药 / 停止作业）：
#   配置了 QWEN_API_KEY → 规则引擎先按防抖规则算出候选，再由千问大模型复核判断
#                        （可同意 / 调整时长 / 改为不作业），并生成自然语言解释推送到网页
#   未配置 QWEN_API_KEY → 完全使用内置规则引擎判断（防抖 / 阈值 / 天气条件），零依赖演示
# 接口: https://dashscope.aliyuncs.com/compatible-mode/v1（阿里云百炼，OpenAI 兼容）
# API Key 申请: https://bailian.console.aliyun.com/
QWEN_API_KEY=your_qwen_api_key

# 可选: 接口地址，默认阿里云百炼 OpenAI 兼容模式
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选: 模型名称，默认 qwen-plus（通用版）；预算有限可换 qwen-turbo，追求效果可换 qwen-max
QWEN_MODEL=qwen-plus

# ================= 通用 =================
# 开启后使用内置演示数据，无需真实 API Key（适合无密钥时体验界面）
DEMO_MODE=false

# 开发者模式：开启后侧边栏出现「开发者控制台」，可查看模型状态/数据体检/一键回测/手动重训
DEV_MODE=false

# ---- MySQL 数据库（用户/茶园/推送记录）----
# 本地默认（开发）:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=tea_garden

# ================= 智能执行 Agent（可选） =================
# 动态展示服务监听地址/端口（默认 127.0.0.1:8510）
AGENT_WS_HOST=127.0.0.1
AGENT_WS_PORT=8510
# Agent 主循环决策间隔（秒，默认 10）
AGENT_INTERVAL=10

# ---- 接云服务器 / 云数据库时，将上面 DB_ 开头的几行改为：----
# DB_HOST=<云服务器IP或域名>
# DB_PORT=3306
# DB_USER=<数据库账号，不建议用 root>
# DB_PASSWORD=<密码>
# DB_NAME=tea_garden
#
# 注意: 本项目不自动建库，只建表。云端需提前:
#   1) 允许远程连接（MySQL 不只绑 127.0.0.1）
#   2) 安全组 / 防火墙放行 3306 端口
#   3) 手动创建库: CREATE DATABASE tea_garden DEFAULT CHARSET utf8mb4;
#   4) 给账号授权该库
